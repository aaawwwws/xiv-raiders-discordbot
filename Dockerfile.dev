FROM mcr.microsoft.com/dotnet/sdk:10.0

ENV LANG=ja_JP.UTF-8
ENV LC_ALL=ja_JP.UTF-8
ENV DOTNET_CLI_UI_LANGUAGE=ja

RUN apt-get update && \
    apt-get install -y --no-install-recommends locales libopus-dev libsodium-dev fonts-noto-cjk unzip wget && \
    sed -i '/ja_JP.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen ja_JP.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

RUN wget https://github.com/discord/libdave/releases/download/v1.1.1%2Fcpp/libdave-Linux-X64-boringssl.zip -O /tmp/libdave.zip && \
    unzip -o /tmp/libdave.zip -d /tmp/libdave && \
    cp /tmp/libdave/lib/libdave.so /usr/local/lib/ && \
    ldconfig && \
    rm -rf /tmp/libdave.zip /tmp/libdave

# Playwright browser dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
       libglib2.0-0 libnss3 libnspr4 libdbus-1-3 \
       libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
       libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
       libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
       libasound2t64 libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY RaidDcBot.csproj ./
RUN dotnet restore RaidDcBot.csproj

# Note: Playwright browsers are installed at runtime via docker-compose command
